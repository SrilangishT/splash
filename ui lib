-- Tab buttons creation & switching logic
local tabNames = {"Main", "Visual", "Misc"}
local pages = {Main = mainPage, Visual = visualPage, Misc = miscPage}

for i, tName in ipairs(tabNames) do
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(0, 90, 0, 26)
	tabBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(45, 45, 55) or Color3.fromRGB(32, 32, 38)
	tabBtn.AutoButtonColor = false
	tabBtn.Font = Enum.Font.GothamBold
	tabBtn.Text = tName
	tabBtn.TextColor3 = (i == 1) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
	tabBtn.TextSize = 12
	tabBtn.Parent = tabsContainer
	
	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(0, 6)
	tCorner.Parent = tabBtn
	
	tabBtn.MouseButton1Click:Connect(function()
		for _, p in pairs(pages) do p.Visible = false end
		for _, b in ipairs(tabsContainer:GetChildren()) do
			if b:IsA("TextButton") then
				b.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
				b.TextColor3 = Color3.fromRGB(150, 150, 160)
			end
		end
		pages[tName].Visible = true
		tabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

-- ==========================================
-- 3. INTERACTION & DRAGGING LOGIC
-- ==========================================
toggleButton.MouseButton1Click:Connect(function()
	hubWindow.Visible = not hubWindow.Visible
end)

-- Draggable Main Hub Window via Title Bar
local hubDragging = false
local hubDragStart, hubStartPos

titleLabel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		hubDragging = true
		hubDragStart = input.Position
		hubStartPos = hubWindow.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				hubDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if hubDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - hubDragStart
		hubWindow.Position = UDim2.new(
			hubStartPos.X.Scale, 
			hubStartPos.X.Offset + delta.X, 
			hubStartPos.Y.Scale, 
			hubStartPos.Y.Offset + delta.Y
		)
	end
end)
